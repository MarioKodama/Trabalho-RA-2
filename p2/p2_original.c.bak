							}
							

						}

						atual = atual->next;
					
				
			}
			




		}

		else if (selected == 3) {
			selected = -1;
			system("cls");
			imprimir_categorias(head_categoria);
			printf("%s", "Digite o número da categoria:");
			int n;
			scanf("%d", &n);
			system("cls");




			Node_Categoria* atual = head_categoria;
